# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so your secrets stay out of git.

# OneSignal — from onesignal.com dashboard > Settings > Keys & IDs
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

# Secret key required to create/edit/delete blogs via the API and admin page.
# Make this a long random string. Without it, write endpoints are disabled.
ADMIN_API_KEY=7ea33fb9fc19e4142259e185592bd51f6db59f84eaef33e1
