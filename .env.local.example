# Secret key(s) required to create/edit/delete blogs and stories via the
# API and admin pages. Make each one a long random string.
# For a single admin:
ADMIN_API_KEY=choose-a-long-random-secret
# For multiple admins, separate keys with a comma — anyone holding any one
# of these keys can create/edit/delete content:
# ADMIN_API_KEY=key-for-priya,key-for-arjun
# Without this set, write endpoints are disabled entirely.